<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP to any host: the server is reached through Tailscale (WireGuard-encrypted)
     under a name or address each user chooses, so no fixed host list is possible.
     The API token is only ever sent to the configured server (ApiProvider). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
